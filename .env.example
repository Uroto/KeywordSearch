# Google Ads API OAuth credentials. The owning Google Cloud project determines API access.
# Leave unset to use the safe dummy-data mode.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Optional manager account ID, without hyphens.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

TARGET_LOCATION_ID=2392
TARGET_LANGUAGE_ID=1005
CACHE_RELATED_DAYS=7
CACHE_METRICS_DAYS=30
CACHE_FORCE_REFRESH=false
BATCH_SIZE=1000
